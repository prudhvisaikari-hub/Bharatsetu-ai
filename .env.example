# BharatSetu AI Configuration

# LLM Orchestration (Setu)
# Optional: without ANTHROPIC_API_KEY, runs in offline mode with deterministic keyword routing
ANTHROPIC_API_KEY=
BHARATSETU_MODEL=claude-3-5-sonnet-20241022

# Persistence
# Uses SQLite for local dev/testing, PostgreSQL in production
DATABASE_URL=sqlite:///./bharatsetu.db

# Security & Authentication
JWT_SECRET=bharatsetu-msme-pithampur-secure-jwt-key-2026
JWT_EXPIRATION_HOURS=24

# API Governance & Rate Limits
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_PER_MINUTE=120

# Digital Public Infrastructure (DPI)
# "mock" for offline sandbox / tests, "real" to connect to live sandbox APIs
DPI_MODE=mock

# Channels & Integrations
WHATSAPP_VERIFY_TOKEN=bharatsetu_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
