# BharatSetu AI Configuration

# LLM Orchestration (Setu)
# Optional: without ANTHROPIC_API_KEY, runs in offline mode with deterministic keyword routing
ANTHROPIC_API_KEY=
BHARATSETU_MODEL=claude-sonnet-5-5

# Persistence
# Uses SQLite for local dev/testing, PostgreSQL in production
DATABASE_URL=sqlite:///./bharatsetu.db

# Security & Authentication
# Required in production: minimum 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
SEED_OWNER_PASSWORD=
# Key for HMAC-SHA256 phone number hashing: minimum 32 characters in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PHONE_HASH_KEY=

# API Governance & Rate Limits
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_PER_MINUTE=60

# Operational Mode
# When false (production default): enforces strict JWT auth on all endpoints, no auto-seeded demo user, docs hidden
# When true: permits anonymous read/write access to "demo" tenant for hackathon judging & offline demos
DEMO_MODE=false
ENABLE_DOCS=false

# Digital Public Infrastructure (DPI)
# "mock" for offline sandbox / tests, "real" to connect to live sandbox APIs
DPI_MODE=mock

# Channels & Integrations
# Required for Meta WhatsApp Webhook: minimum 16 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
